# Virtual environments (recreate with: pip install -r requirements.txt)
.venv/
.venv312/

# Converted OpenVINO models - ~2.9 GB, and regenerable with benchmark/convert_slm.py.
# GitHub rejects files over 100 MB, so these can never be committed anyway.
models/

# PRIVACY: profile.json holds a real home address, real names, and medical conditions.
# It is deliberately local-only - data/profile.example.json is the committed template.
data/profile.json

# PRIVACY: the same details, SPOKEN ALOUD. Committing these would leak a real home address as
# audio - exactly what excluding profile.json prevents for text. Rebuild per install with
# `python tools/build_audio.py`. The shared audio in data/audio/ IS committed: it is the same
# for every user, and shipping it is what frees the app from needing a Japanese voice installed.
data/audio/profile/

# LICENSING: L2-ARCTIC accent samples are gated access under CC BY-NC 4.0.
# Redistributing them here would breach that license. Downloaded separately per-machine.
data/accent_test/

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store
